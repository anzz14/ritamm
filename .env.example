# OpenAI-compatible LLM API key. Leave blank when using rules-only tests.
LLM_API_KEY=
# OpenAI-compatible API base URL.
LLM_BASE_URL=https://openrouter.ai/api/v1
# Model identifier accepted by the configured API.
LLM_MODEL=openai/gpt-oss-20b:free
# Port for the bank ingestion agent.
AGENT_A_PORT=8001
# Port for the NAV review agent.
AGENT_B_PORT=8002
# Directory containing the quarter-close input pack.
PACK_DIR=./pack